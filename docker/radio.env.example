# Where MUS listens: an IPv4 address and port (RtTC doesn't take host names).
# 127.0.0.1:9000 when MUS runs on this machine.
MUS_ADDR=192.168.1.10:9000

# This host's group IDs for the sound card and serial ports. Find them with:
#   stat -c %g /dev/snd/controlC0     (or: getent group audio)
#   stat -c %g /dev/ttyACM0           (or: getent group dialout)
AUDIO_GID=29
DIALOUT_GID=20

# Extra RadioConnector arguments, e.g. --verbose or --verbose --direwolf
RTTC_ARGS=
